## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.
##
## Based on:
## https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# =========================
# Build results
# =========================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# =========================
# .NET Core / ASP.NET Core
# =========================
project.lock.json
project.fragment.lock.json
ScaffoldingReadMe.txt

# =========================
# User-specific files
# =========================
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# =========================
# Visual Studio
# =========================
.vs/

# Visual Studio cache/options
*.cache
*.ide/
*.VC.db
*.VC.VC.opendb

# =========================
# Rider / JetBrains
# =========================
.idea/
*.sln.iml

# =========================
# VS Code
# =========================
.vscode/

# =========================
# NuGet
# =========================
*.nupkg
*.snupkg

# Packages folder
packages/

# NuGet Symbol Packages
*.symbols.nupkg

# =========================
# Test Results
# =========================
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResults/
CodeCoverage/

# MSTest
*.trx

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# xUnit
xunit.runner.json

# =========================
# Logs
# =========================
*.log
*.binlog

# =========================
# Temporary files
# =========================
~$*
*~
*.tmp
*.temp

# =========================
# Publish output
# =========================
publish/

# =========================
# Environment files
# =========================
.env
.env.*
!.env.example

# =========================
# ASP.NET Core appsettings
# Keep base config tracked
# Ignore environment-specific secrets
# =========================
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json

# Optional backend-specific overrides
BackEnd/appsettings.Development.json
BackEnd/appsettings.Production.json
BackEnd/appsettings.Local.json

# =========================
# OS-generated files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Azure
# =========================
.publishsettings
azureSettings.json

# =========================
# Docker
# =========================
docker-compose.override.yml

# =========================
# Generated files
# =========================
Generated/
wwwroot/dist/
wwwroot/lib/

# =========================
# SQLite databases
# =========================
*.db
*.sqlite
*.sqlite3

# =========================
# Entity Framework
# =========================
*.mdf
*.ldf

# =========================
# Node.js (if frontend exists)
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Coverage reports
# =========================
coverage/
coverage.xml
lcov.info

# =========================
# Backup files
# =========================
*.bak
*.backup

# =========================
# Secrets
# =========================
secrets.json

# =========================
# Mac/Linux executable permissions
# =========================
*.pidb
*.svclog

# =========================
# C# interactive
# =========================
*.csx

# =========================
# Resharper
# =========================
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# =========================
# BenchmarkDotNet
# =========================
BenchmarkDotNet.Artifacts/

# =========================
# Optional: Ignore all local settings
# Uncomment if needed
# =========================
# appsettings.*.json
# !appsettings.json